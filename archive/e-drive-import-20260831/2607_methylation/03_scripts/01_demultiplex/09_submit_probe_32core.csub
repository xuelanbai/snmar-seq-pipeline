#!/usr/bin/env bash
# Step 09: submit the 32-core probe job.
#CSUB -J snMAR_probe32
#CSUB -q c02
#CSUB -n 32
#CSUB -o 09_logs/01_demultiplex/09_probe32.out
#CSUB -e 09_logs/01_demultiplex/09_probe32.err

set -euo pipefail

PROJECT=/share/org/YZWL/yzwl_wujx/Projects/2607_methylation
cd "$PROJECT"

mkdir -p 09_logs/01_demultiplex

export PROJECT
export JOBS=32
export PROBE_READS=200000

bash 03_scripts/01_demultiplex/06_run_demultiplex.sh probe
