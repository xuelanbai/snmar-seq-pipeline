#!/usr/bin/env bash
# Step 128: validate 96 TSS matrices and build the complete VDS.
#CSUB -J snMAR_DNA_TSS_merge
#CSUB -q c02
#CSUB -n 16
#CSUB -R "span[hosts=1]"
#CSUB -o 09_logs/05_downstream_analysis/dna_tss_umap/merge.out
#CSUB -e 09_logs/05_downstream_analysis/dna_tss_umap/merge.err

set -euo pipefail

source "${CONDA_SH:-/share/apps/anaconda3/etc/profile.d/conda.sh}"
conda activate "${DNA_ALIGN_ENV:-snTAPS_align}"

PROJECT="${PROJECT:-/share/org/YZWL/yzwl_wujx/Projects/2607_methylation}"
SCRIPT_ROOT="${SNMAR_SCRIPT_ROOT:-$PROJECT/03_scripts}"
SCRIPT="$SCRIPT_ROOT/05_downstream_analysis/06_dna_tss_umap/127_merge_dna_tss_complete_matrix.py"
WELL_QC="$PROJECT/08_qc_summary/38_dna_tss_promoters/well_matrices"
PYTHON_BIN="$(command -v "${PYTHON:-python}" || true)"

[[ -x "$PYTHON_BIN" ]] || exit 127
"$PYTHON_BIN" -c 'import h5py, numpy' || {
  echo "[ERROR] snTAPS_align lacks h5py or numpy" >&2
  exit 2
}
[[ -s "$SCRIPT" ]] || {
  echo "[ERROR] missing/empty script: $SCRIPT" >&2
  exit 2
}
completed="$(find "$WELL_QC" -maxdepth 1 -type f \
  -name '*.dna_tss_promoters.summary.tsv' -size +0c 2>/dev/null | wc -l)"
(( completed == 96 )) || {
  echo "[ERROR] expected 96 TSS well summaries, found $completed" >&2
  exit 2
}

mkdir -p "$PROJECT/09_logs/05_downstream_analysis/dna_tss_umap"
cd "$PROJECT"
"$PYTHON_BIN" "$SCRIPT" --project "$PROJECT"
