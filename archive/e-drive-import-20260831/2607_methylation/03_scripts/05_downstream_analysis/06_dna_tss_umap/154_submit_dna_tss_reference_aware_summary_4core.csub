#!/usr/bin/env bash
# Step 154: summarize validated D20/D50 reference-aware promoter UMAPs.
#CSUB -J snMAR_TSS_REF_SUM
#CSUB -q c02
#CSUB -n 4
#CSUB -R "span[hosts=1]"
#CSUB -o 09_logs/05_downstream_analysis/dna_tss_umap/reference_aware_summary.out
#CSUB -e 09_logs/05_downstream_analysis/dna_tss_umap/reference_aware_summary.err

set -euo pipefail
source "${CONDA_SH:-/share/apps/anaconda3/etc/profile.d/conda.sh}"
conda activate "${DNA_UMAP_ENV:-snTAPS_analysis}"

PROJECT="${PROJECT:-/share/org/YZWL/yzwl_wujx/Projects/2607_methylation}"
SCRIPT_ROOT="${SNMAR_SCRIPT_ROOT:-$PROJECT/03_scripts}"
SCRIPT="$SCRIPT_ROOT/05_downstream_analysis/06_dna_tss_umap/153_summarize_dna_tss_reference_aware.py"
PYTHON_BIN="$(command -v "${PYTHON:-python}" || true)"
[[ -x "$PYTHON_BIN" && -s "$SCRIPT" ]] || exit 127
"$PYTHON_BIN" -c 'import numpy, sklearn' || exit 2
mkdir -p "$PROJECT/09_logs/05_downstream_analysis/dna_tss_umap"
cd "$PROJECT"
"$PYTHON_BIN" "$SCRIPT" --project "$PROJECT"
