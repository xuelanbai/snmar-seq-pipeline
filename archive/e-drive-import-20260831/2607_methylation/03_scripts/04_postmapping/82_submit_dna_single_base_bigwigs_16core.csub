#!/usr/bin/env bash
# Step 82: build species-separated per-base WCG/GCH BigWig tracks.
#
#CSUB -J snMAR_DNA_single_base_BW
#CSUB -q c02
#CSUB -n 16
#CSUB -R "span[hosts=1]"
#CSUB -o 09_logs/04_postmapping/82_dna_single_base_bigwig.out
#CSUB -e 09_logs/04_postmapping/82_dna_single_base_bigwig.err

set -euo pipefail

source /share/apps/anaconda3/etc/profile.d/conda.sh
BIGWIG_ENV="${BIGWIG_ENV:-foodie_env}"
conda activate "$BIGWIG_ENV"

PROJECT="${PROJECT:-/share/org/YZWL/yzwl_wujx/Projects/2607_methylation}"
POST_DIR="$PROJECT/03_scripts/04_postmapping"
PYTHON_BIN="$(command -v "${PYTHON:-python}" || true)"
BEDGRAPH_TO_BIGWIG="$(
  command -v "${BEDGRAPH_TO_BIGWIG_REQUESTED:-bedGraphToBigWig}" || true
)"
[[ -x "$PYTHON_BIN" ]] || {
  echo "[ERROR] python is unavailable" >&2
  exit 127
}
"$PYTHON_BIN" -c 'import numpy' || {
  echo "[ERROR] numpy is unavailable in $BIGWIG_ENV" >&2
  exit 127
}
[[ -x "$BEDGRAPH_TO_BIGWIG" ]] || {
  echo "[ERROR] bedGraphToBigWig is unavailable in $BIGWIG_ENV" >&2
  echo "[HINT] set BIGWIG_ENV to an environment containing " >&2
  echo "       ucsc-bedgraphtobigwig, or install it in $BIGWIG_ENV" >&2
  exit 127
}
[[ -s "$POST_DIR/81_build_dna_single_base_bigwigs.py" ]] || exit 2

mkdir -p "$PROJECT/09_logs/04_postmapping"
cd "$PROJECT"
"$PYTHON_BIN" "$POST_DIR/81_build_dna_single_base_bigwigs.py" \
  --project "$PROJECT" \
  --bedgraph-to-bigwig "$BEDGRAPH_TO_BIGWIG"
