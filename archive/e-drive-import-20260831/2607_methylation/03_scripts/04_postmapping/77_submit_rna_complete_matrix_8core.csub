#!/usr/bin/env bash
# Step 77: validate/package complete raw and filtered RNA matrices.
#
#CSUB -J snMAR_RNA_complete
#CSUB -q c02
#CSUB -n 8
#CSUB -R "span[hosts=1]"
#CSUB -o 09_logs/04_postmapping/complete_matrices/rna.out
#CSUB -e 09_logs/04_postmapping/complete_matrices/rna.err

set -euo pipefail

source /share/apps/anaconda3/etc/profile.d/conda.sh
conda activate "${RNA_ALIGN_ENV:-snTAPS_align}"

PROJECT="${PROJECT:-/share/org/YZWL/yzwl_wujx/Projects/2607_methylation}"
POST_DIR="$PROJECT/03_scripts/04_postmapping"
MIN_EXACT_UMIS="${MIN_EXACT_UMIS:-10}"
MIN_GENES="${MIN_GENES:-5}"
PYTHON_BIN="$(command -v "${PYTHON:-python}" || true)"
[[ -x "$PYTHON_BIN" ]] || exit 127
"$PYTHON_BIN" -c 'import h5py, numpy'
mkdir -p "$PROJECT/09_logs/04_postmapping/complete_matrices"
cd "$PROJECT"
"$PYTHON_BIN" "$POST_DIR/76_validate_rna_complete_matrix.py" \
  --project "$PROJECT" \
  --minimum-exact-umis "$MIN_EXACT_UMIS" \
  --minimum-genes "$MIN_GENES"

