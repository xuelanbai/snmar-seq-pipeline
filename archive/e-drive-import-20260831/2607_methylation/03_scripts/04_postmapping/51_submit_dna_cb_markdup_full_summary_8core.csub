#!/usr/bin/env bash
# Step 51: validate and summarize all 96 DNA CB-aware dedup outputs.
#
#CSUB -J snMAR_DNA_CBdup_summary
#CSUB -q c02
#CSUB -n 8
#CSUB -R "span[hosts=1]"
#CSUB -o 09_logs/04_postmapping/51_dna_cb_markdup_summary.out
#CSUB -e 09_logs/04_postmapping/51_dna_cb_markdup_summary.err

set -euo pipefail

source /share/apps/anaconda3/etc/profile.d/conda.sh
conda activate "${DNA_ALIGN_ENV:-snTAPS_align}"

PROJECT="${PROJECT:-/share/org/YZWL/yzwl_wujx/Projects/2607_methylation}"
POST_DIR="$PROJECT/03_scripts/04_postmapping"
PYTHON_BIN="$(command -v "${PYTHON:-python}" || true)"
SAMTOOLS_BIN="$(command -v "${SAMTOOLS:-samtools}" || true)"
[[ -x "$PYTHON_BIN" && -x "$SAMTOOLS_BIN" ]] || exit 127
[[ -s "$POST_DIR/45_summarize_dna_cb_markdup_full.py" ]] || exit 2

cd "$PROJECT"
mkdir -p "$PROJECT/09_logs/04_postmapping"
"$PYTHON_BIN" "$POST_DIR/45_summarize_dna_cb_markdup_full.py" \
  --project "$PROJECT" \
  --samtools "$SAMTOOLS_BIN"

