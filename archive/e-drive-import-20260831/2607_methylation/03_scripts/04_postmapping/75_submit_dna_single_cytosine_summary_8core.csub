#!/usr/bin/env bash
# Step 75: validate the full DNA WCG/GCH result and create its HDF5 VDS.
#
#CSUB -J snMAR_Cyt_final
#CSUB -q c02
#CSUB -n 8
#CSUB -R "span[hosts=1]"
#CSUB -o 09_logs/04_postmapping/single_cytosine/final.out
#CSUB -e 09_logs/04_postmapping/single_cytosine/final.err

set -euo pipefail

source /share/apps/anaconda3/etc/profile.d/conda.sh
conda activate "${DNA_ALIGN_ENV:-snTAPS_align}"

PROJECT="${PROJECT:-/share/org/YZWL/yzwl_wujx/Projects/2607_methylation}"
POST_DIR="$PROJECT/03_scripts/04_postmapping"
PYTHON_BIN="$(command -v "${PYTHON:-python}" || true)"
[[ -x "$PYTHON_BIN" ]] || exit 127
"$PYTHON_BIN" -c 'import h5py'
mkdir -p "$PROJECT/09_logs/04_postmapping/single_cytosine"
cd "$PROJECT"
"$PYTHON_BIN" "$POST_DIR/74_summarize_dna_single_cytosine_full.py" \
  --project "$PROJECT"
