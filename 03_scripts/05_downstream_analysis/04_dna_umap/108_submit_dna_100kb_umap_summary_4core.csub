#!/usr/bin/env bash
# Step 108: validate and compare completed D20/D50 DNA UMAP runs.
#CSUB -J snMAR_DNA_UMAP_summary
#CSUB -q c02
#CSUB -n 4
#CSUB -R "span[hosts=1]"
#CSUB -o 09_logs/05_downstream_analysis/dna_100kb_umap/summary.out
#CSUB -e 09_logs/05_downstream_analysis/dna_100kb_umap/summary.err

set -euo pipefail

source "${CONDA_SH:-/share/apps/anaconda3/etc/profile.d/conda.sh}"
conda activate "${DNA_UMAP_ENV:-foodie_env}"

PROJECT="${PROJECT:-/share/org/YZWL/yzwl_wujx/Projects/2607_methylation}"
SCRIPT_ROOT="${SNMAR_SCRIPT_ROOT:-$PROJECT/03_scripts}"
SCRIPT="$SCRIPT_ROOT/05_downstream_analysis/04_dna_umap/107_summarize_dna_100kb_umap.py"
PYTHON_BIN="$(command -v "${PYTHON:-python}" || true)"

[[ -x "$PYTHON_BIN" ]] || {
  echo "[ERROR] python is unavailable" >&2
  exit 127
}
[[ -s "$SCRIPT" ]] || {
  echo "[ERROR] missing/empty script: $SCRIPT" >&2
  exit 2
}
mkdir -p "$PROJECT/09_logs/05_downstream_analysis/dna_100kb_umap"
cd "$PROJECT"
"$PYTHON_BIN" "$SCRIPT" --project "$PROJECT"
