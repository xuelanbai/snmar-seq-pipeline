#!/usr/bin/env bash
# Step 150: summarize the fixed four-run high-variable promoter grid.
#CSUB -J snMAR_TSS_HVF_summary
#CSUB -q c02
#CSUB -n 4
#CSUB -R "span[hosts=1]"
#CSUB -o 09_logs/05_downstream_analysis/dna_tss_umap/hvf/summary.out
#CSUB -e 09_logs/05_downstream_analysis/dna_tss_umap/hvf/summary.err

set -euo pipefail

source "${CONDA_SH:-/share/apps/anaconda3/etc/profile.d/conda.sh}"
conda activate "${DNA_UMAP_ENV:-snTAPS_analysis}"

PROJECT="${PROJECT:-/share/org/YZWL/yzwl_wujx/Projects/2607_methylation}"
SCRIPT_ROOT="${SNMAR_SCRIPT_ROOT:-$PROJECT/03_scripts}"
SCRIPT="$SCRIPT_ROOT/05_downstream_analysis/06_dna_tss_umap/149_summarize_dna_tss_hvf.py"
PYTHON_BIN="$(command -v "${PYTHON:-python}" || true)"

[[ -x "$PYTHON_BIN" ]] || exit 127
"$PYTHON_BIN" -c 'import numpy, sklearn' || {
  echo "[ERROR] snTAPS_analysis lacks high-variable TSS summary dependencies" >&2
  exit 2
}
[[ -s "$SCRIPT" ]] || {
  echo "[ERROR] missing/empty script: $SCRIPT" >&2
  exit 2
}

mkdir -p "$PROJECT/09_logs/05_downstream_analysis/dna_tss_umap/hvf"
cd "$PROJECT"
"$PYTHON_BIN" "$SCRIPT" --project "$PROJECT"
