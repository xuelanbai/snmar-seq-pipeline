#!/usr/bin/env bash
# Step 134: validate and compare the D20/D50 TSS UMAP runs.
#CSUB -J snMAR_TSS_UMAP_summary
#CSUB -q c02
#CSUB -n 4
#CSUB -R "span[hosts=1]"
#CSUB -o 09_logs/05_downstream_analysis/dna_tss_umap/summary.out
#CSUB -e 09_logs/05_downstream_analysis/dna_tss_umap/summary.err

set -euo pipefail

source "${CONDA_SH:-/share/apps/anaconda3/etc/profile.d/conda.sh}"
conda activate "${DNA_UMAP_ENV:-snTAPS_analysis}"

PROJECT="${PROJECT:-/share/org/YZWL/yzwl_wujx/Projects/2607_methylation}"
SCRIPT_ROOT="${SNMAR_SCRIPT_ROOT:-$PROJECT/03_scripts}"
SCRIPT="$SCRIPT_ROOT/05_downstream_analysis/06_dna_tss_umap/133_summarize_dna_tss_umap.py"
PYTHON_BIN="$(command -v "${PYTHON:-python}" || true)"

[[ -x "$PYTHON_BIN" ]] || exit 127
"$PYTHON_BIN" -c 'import numpy, sklearn' || {
  echo "[ERROR] snTAPS_analysis lacks summary dependencies" >&2
  exit 2
}
[[ -s "$SCRIPT" ]] || exit 2
for run in \
  ortholog_single_gene_D20k_TSSctx25 \
  ortholog_single_gene_D50k_TSSctx25; do
  summary="$PROJECT/08_qc_summary/39_dna_tss_umap/$run/dna_tss_umap_summary.tsv"
  [[ -s "$summary" ]] || {
    echo "[ERROR] missing TSS UMAP result: $summary" >&2
    exit 2
  }
done

mkdir -p "$PROJECT/09_logs/05_downstream_analysis/dna_tss_umap"
cd "$PROJECT"
"$PYTHON_BIN" "$SCRIPT" --project "$PROJECT" --neighbors 15
