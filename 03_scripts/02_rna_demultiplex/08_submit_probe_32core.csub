#!/usr/bin/env bash
# Step 08: submit the 32-core RNA strict-structure probe.
#CSUB -J snMAR_RNAprobe32
#CSUB -q c02
#CSUB -n 32
#CSUB -o 09_logs/02_rna_demultiplex/08_probe32.out
#CSUB -e 09_logs/02_rna_demultiplex/08_probe32.err

set -euo pipefail

PROJECT="${PROJECT:-/share/org/YZWL/yzwl_wujx/Projects/2607_methylation}"
SCRIPT_ROOT="${SNMAR_SCRIPT_ROOT:-$PROJECT/03_scripts}/02_rna_demultiplex"
cd "$PROJECT"
mkdir -p 09_logs/02_rna_demultiplex

export PROJECT
export JOBS=32
export PROBE_READS=200000

bash "$SCRIPT_ROOT/06_run_rna_demultiplex.sh" probe
