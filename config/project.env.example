#!/usr/bin/env bash
# Copy to config/project.env and edit it. project.env is ignored by Git.

# Data/output project root on the cluster.
export PROJECT=/share/org/YZWL/yzwl_wujx/Projects/2607_methylation

# Absolute path to this repository's 03_scripts directory on the cluster.
# This allows the repository to be cloned outside PROJECT.
export SNMAR_SCRIPT_ROOT=/path/to/snmar-seq-pipeline/03_scripts

# Conda initialization and environments already used by this project.
export CONDA_SH=/share/apps/anaconda3/etc/profile.d/conda.sh
export DNA_ALIGN_ENV=snTAPS_align
export RNA_ALIGN_ENV=snTAPS_align
export BIGWIG_ENV=foodie_env

# Raw inputs.
export DNA_RAW_ROOT=/path/to/dna/rawdata
export RNA_RAW_ROOT=/path/to/rna/rawdata

# Human/pig reference inputs used to build the prefixed joint reference.
export HUMAN_FASTA=/path/to/Homo_sapiens.GRCh38.dna.primary_assembly.fa
export HUMAN_GTF=/path/to/Homo_sapiens.GRCh38.115.gtf.gz
export PIG_FASTA=/path/to/Sus_scrofa.Sscrofa11.1.dna.toplevel.fa
export PIG_GTF=/path/to/Sus_scrofa.Sscrofa11.1.115.gtf.gz

# Optional executable overrides. Leave unset when commands are on PATH.
# export PYTHON=/path/to/python
# export SAMTOOLS=/path/to/samtools
# export STAR=/path/to/STAR
# export BWA=/path/to/bwa
# export FASTP=/path/to/fastp
# export BEDGRAPH_TO_BIGWIG=/path/to/bedGraphToBigWig
